# ====================================================================
# KOTATSU-REDO: ROOT-LEVEL .GITIGNORE
# ====================================================================

# --------------------------------------------------------------------
# 1. Gradle Build Outputs & Caches
# --------------------------------------------------------------------
# Ignore local gradle directories and build artifacts.
# These are generated during build and should not be tracked.
.gradle/
build/
/*/build/

# --------------------------------------------------------------------
# 2. Kotlin Compiler Cache
# --------------------------------------------------------------------
# Kotlin plugin build caches are generated locally and vary per machine.
.kotlin/

# --------------------------------------------------------------------
# 3. Android Studio / IntelliJ IDEA Configuration
# --------------------------------------------------------------------
# User-specific configurations and cache folders for the IDE.
# Files like *.iml are project/module structures generated by IDE.
.idea/
*.iml
*.ipr
*.iws
out/

# --------------------------------------------------------------------
# 4. VS Code Settings & Configuration
# --------------------------------------------------------------------
# If any developer uses VS Code, prevent committing workspace settings.
.vscode/

# --------------------------------------------------------------------
# 5. OS & System Generated Files
# --------------------------------------------------------------------
# OS-specific files that clutter directories.
.DS_Store
Thumbs.db
db.rebuild
ehthumbs.db

# --------------------------------------------------------------------
# 6. Local & Environment Configuration Properties
# --------------------------------------------------------------------
# local.properties contains local Android SDK and NDK paths.
# Each developer has a unique path to their Android SDK.
local.properties

# --------------------------------------------------------------------
# 7. Keystores and Signing Credentials (SECURITY CRITICAL)
# --------------------------------------------------------------------
# Signing keystores contain private keys used to sign release APKs.
# NEVER commit these to a public or private repository.
*.keystore
*.jks
*.pepk
*.pkcs12
*.p12
totoro-release.keystore

# --------------------------------------------------------------------
# 8. Certificates & Keys
# --------------------------------------------------------------------
# Ignore certificate files globally to avoid leaking private keys.
*.pem
*.key
*.pub
*.crt

# EXCEPTIONS:
# Keep public certificate authorities/assets required for the app's network layer.
# (e.g., app/src/debug/assets/isrgrootx1.pem)
!**/src/**/*.pem
!**/src/**/*.crt

# --------------------------------------------------------------------
# 9. Logs & Dumps
# --------------------------------------------------------------------
# Log outputs and Java Heap Profile dump files (from memory troubleshooting).
*.log
*.hprof

# --------------------------------------------------------------------
# 10. Localization & Translation (Weblate)
# --------------------------------------------------------------------
# The .weblate configuration file at the root should be COMMITTED to
# track the Weblate integration settings.
# However, ignore temporary or backup translation files.
.weblate.tmp
.weblate.bak

# --------------------------------------------------------------------
# 11. Fastlane Deployment Logs & Reports (If used)
# --------------------------------------------------------------------
# Keep fastlane/Appfile and fastlane/Fastfile config, but ignore outputs.
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output/

# --------------------------------------------------------------------
# 12. Test Assets Exceptions
# --------------------------------------------------------------------
# If *.bak is ignored globally, we must make sure kotatsu_test.bak
# (which contains JSON test assets for categories/manga tests) is committed.
!**/kotatsu_test.bak/
!**/kotatsu_test.bak/**

# ====================================================================
# SECURITY CHECKLIST:
# 1. Did you verify totoro-release.keystore is untracked?
# 2. Are your Groq API / AI credentials, Shikimori/MAL/Discord client secrets, 
#    or server sync tokens kept in local.properties or environment variables?
#    (Do not commit them in gradle.properties or source code!)
# ====================================================================
