<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="24dp"
	android:background="?attr/colorSurface">

	<!-- Header -->
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/ai_onboarding_title"
		android:textColor="?attr/colorOnSurface"
		android:textSize="20sp"
		android:textStyle="bold"
		android:layout_marginBottom="20dp" />

	<!-- Bullet 1 -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginBottom="16dp">

		<ImageView
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_auto_awesome"
			app:tint="?attr/colorPrimary"
			android:contentDescription="@null"
			android:layout_marginEnd="12dp" />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/ai_onboarding_body1"
			android:textColor="?attr/colorOnSurface"
			android:textSize="15sp" />
	</LinearLayout>

	<!-- Bullet 2 -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginBottom="16dp">

		<ImageView
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_manga_source"
			app:tint="?attr/colorPrimary"
			android:contentDescription="@null"
			android:layout_marginEnd="12dp" />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/ai_onboarding_body2"
			android:textColor="?attr/colorOnSurface"
			android:textSize="15sp" />
	</LinearLayout>

	<!-- Bullet 3 -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:layout_marginBottom="28dp">

		<ImageView
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:src="@drawable/ic_tag"
			app:tint="?attr/colorPrimary"
			android:contentDescription="@null"
			android:layout_marginEnd="12dp" />

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/ai_onboarding_body3"
			android:textColor="?attr/colorOnSurface"
			android:textSize="15sp" />
	</LinearLayout>

	<!-- Got it button -->
	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_onboarding_got_it"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/ai_onboarding_dismiss"
		android:layout_marginBottom="8dp" />

</LinearLayout>
